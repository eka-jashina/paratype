---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Страница не найдена — Paratype">
  <Header />
  <main class="main">
    <section class="section">
      <div class="container" style="text-align: center; padding: 100px 30px;">
        <h1 style="font-size: 120px; font-weight: 900; line-height: 1; margin: 0;">404</h1>
        <p style="font-size: 24px; margin-top: 20px;">Страница не найдена</p>
        <a href="/" style="display: inline-block; margin-top: 30px; font-size: 16px; color: #ff4b41; text-decoration: underline;">Вернуться на главную</a>
      </div>
    </section>
  </main>
  <Footer />
</Base>
