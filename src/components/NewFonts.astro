---
import { Icon } from 'astro-icon/components';
import NewFontCard from './NewFontCard.astro';
import newFonts from '../data/new-font-cards.json';
---

<section class="new-fonts section">
  <div class="container">
    <h2 class="visually-hidden">Новые шрифты</h2>
    <div class="new-fonts__controls">
      <div class="new-fonts__filter">
        <button class="new-fonts__filter-button" type="button"></button>
        <ul class="new-fonts__categories-list" aria-label="Фильтры шрифтов по категориям">
          <li>
            <button class="new-fonts__category is-active" type="button" data-filter="all">все новинки</button>
          </li>
          <li>
            <button class="new-fonts__category" type="button" data-filter="sale">распродажа</button>
          </li>
          <li>
            <button class="new-fonts__category" type="button" data-filter="recommend">рекомендуем</button>
          </li>
          <li>
            <button class="new-fonts__category" type="button" data-filter="bestsellers">бестселлеры</button>
          </li>
        </ul>
      </div>
      <div class="new-fonts__sorting sorting">
        <button class="sorting__button sorting__button--active" type="button">
          <span class="visually-hidden">Сортировка плиткой</span>
          <Icon name="tile" width="24" height="24" />
        </button>
        <button class="sorting__button" type="button">
          <span class="visually-hidden">Сортировка списком</span>
          <Icon name="list" width="24" height="24" />
        </button>
      </div>
    </div>
    <ul class="new-fonts__list">
      {newFonts.map((font) => (
        <li class="new-fonts__item">
          <NewFontCard {...font} />
        </li>
      ))}
    </ul>
  </div>
</section>
