---
import { getCollection } from 'astro:content';
import CatalogSectionCard from './CatalogSectionCard.astro';

const catalogSectionCards = await getCollection('catalogSections');
---

<section class="catalog section">
  <div class="container">
    <h2 class="visually-hidden">Каталог шрифтов</h2>
    <ul class="catalog__list scroll-container">
      {catalogSectionCards.map((card) => (
        <li class="catalog__item">
          <CatalogSectionCard {...card.data} />
        </li>
      ))}
    </ul>
  </div>
</section>
