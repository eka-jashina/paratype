---
import BannerCard from './BannerCard.astro';
import banners from '../data/banners.json';
---

<section class="promo section">
  <div class="container">
    <h2 class="visually-hidden">Лучшие предложения</h2>
    <div class="slider">
      <div class="promo__banners banners slider__track">
        {banners.map((banner) => (
          <BannerCard {...banner} />
        ))}
      </div>
      <div class="slider__pagination"></div>
    </div>
  </div>
</section>
