---
import { Icon } from 'astro-icon/components';
import logoDesktop from '../assets/img/content/paratype-logo-desktop.svg';
import logoTablet from '../assets/img/content/paratype-logo-tablet.svg';
---

<header class="header">
  <div class="header__content">
    <div class="container header__container header__container--nav">
      <div class="header__logo logo">
        <picture>
          <source srcset={logoTablet.src} width="40" height="33" media="(max-width: 1023px)">
          <img class="logo__img" src={logoDesktop.src} width="230" height="60" alt="Логотип компании Paratype">
        </picture>
        <span class="logo__text">Основано в 1998</span>
      </div>
      <button class="header__burger" type="button">
        <span class="visually-hidden">Главное меню</span>
      </button>
      <nav class="header__main-nav main-nav">
        <ul class="main-nav__list">
          <li class="main-nav__item">
            <a class="main-nav__link main-nav__link--active" href="#">главная</a>
          </li>
          <li class="main-nav__item">
            <a class="main-nav__link" href="#">каталог</a>
            <span class="main-nav__count">988</span>
          </li>
          <li class="main-nav__item">
            <a class="main-nav__link main-nav__link--accent" href="#">коллекции</a>
            <span class="main-nav__count">45</span>
          </li>
        </ul>
        <ul class="main-nav__list main-nav__list--additional">
          <li class="main-nav__item">
            <a class="main-nav__link" href="#">компания</a>
          </li>
          <li class="main-nav__item">
            <a class="main-nav__link" href="#">справочник</a>
          </li>
        </ul>
        <div class="main-nav__profile">
          <span class="main-nav__profile-title">мой профиль</span>
          <a class="main-nav__profile-link" href="#">войти</a>
          <a class="main-nav__profile-link" href="#">зарегистрироваться</a>
        </div>
      </nav>
      <ul class="header__color-themes color-themes" data-da=".main-nav, 680, first, move" aria-label="Управление цветовой темой сайта">
        <li class="color-themes__item">
          <label class="color-themes__button">
            <Icon name="sun" width="24" height="24" />
            <input class="color-themes__input" type="radio" name="theme-choice" id="light-theme-choice" checked>
            <span class="visually-hidden color-themes__text">Дневная тема</span>
          </label>
        </li>
        <li class="color-themes__item">
          <label class="color-themes__button">
            <Icon name="moon" width="24" height="24" />
            <input class="color-themes__input" type="radio" name="theme-choice" id="dark-theme-choice">
            <span class="visually-hidden color-themes__text">Ночная тема</span>
          </label>
        </li>
      </ul>
      <a class="header__search" href="#">
        <Icon name="search" width="24" height="24" />
        <span class="visually-hidden">Поиск по сайту</span>
      </a>
    </div>
  </div>
  <div class="header__content">
    <div class="container header__container header__container--user">
      <div class="header__sale header-sale">
        <span class="header-sale__title">25% Sale</span>
        <span class="header-sale__text">осенняя распродажа шрифтов</span>
      </div>
      <ul class="header__user-nav user-nav" data-da=".header__container--nav, 680, last, move">
        <li class="user-nav__item">
          <a class="user-nav__link user-nav__link--favorites" href="#">
            <Icon name="favorites" width="24" height="24" />
            <span class="user-nav__count">0</span>
          </a>
        </li>
        <li class="user-nav__item">
          <a class="user-nav__link user-nav__link--cart" href="#">
            <Icon name="cart" width="24" height="24" />
            <span class="user-nav__count">0</span>
          </a>
        </li>
        <li class="user-nav__item">
          <button class="user-nav__button user-nav__button--profile" type="button">
            <Icon name="user" width="24" height="24" />
            <span class="user-nav__text">мой акканут</span>
          </button>
        </li>
      </ul>
    </div>
  </div>
</header>
