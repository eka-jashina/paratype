<article class="banners__item banner card slider__slide {{modifier}}">
  <a class="banner__link card__link" href="{{link}}">
    <h3 class="banner__title card__title">{{title}}</h3>
    <p class="banner__description card__description">{{category}}</p>
    <div class="banner__counts card__counts">
      <span class="banner__count banner__count--all card__count card__count--all">
        <span class="visually-hidden">Всего шрифтов в категории</span>
        {{count-all}}
      </span>
      {{#if count-new}}
        <span class="banner__count banner__count--new card__count card__count--new">
          <span class="visually-hidden">Новых шрифтов в категории</span>
          {{count-new}}
        </span>
      {{/if}}
    </div>
  </a>
</article>
