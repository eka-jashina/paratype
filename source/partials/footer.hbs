<footer class="footer">
  <div class="container footer__container">
    <ul class="footer__menu footer-menu" data-da=".main-nav, 680, 4, copy, footer-menu--copy-in-header">
      <li class="footer-menu__item">
        <a class="footer-menu__link" href="#">FAQ</a>
      </li>
      <li class="footer-menu__item">
        <a class="footer-menu__link" href="#">лицензии</a>
      </li>
      <li class="footer-menu__item">
        <a class="footer-menu__link" href="#">правила продажи</a>
      </li>
      <li class="footer-menu__item">
        <a class="footer-menu__link" href="#">возврат и замена</a>
      </li>
      <li class="footer-menu__item">
        <a class="footer-menu__link" href="#">контакты</a>
      </li>
    </ul>
    <form class="footer__form subscribe-form" method="post" action="http://echo.htmlacademy.ru/">
      <label class="subscribe-form__label">
        <span class="subscribe-form__title">Новости Paratype</span>
        <input class="subscribe-form__input" type="email" name="email" placeholder="ваш email" pattern="^[a-zA-Z0-9._%+\-]+@[a-zA-Z0-9.\-]+\.[A-Za-z]{2,}$" title="Введите корректный email, например: name@example.com" required>
      </label>
      <button class="subscribe-form__submit" type="submit">Подписаться</button>
    </form>
    <div class="footer__information" data-da=".main-nav, 680, last, copy, footer__information--copy-in-header">
      <div class="footer__copyright">
        <span>&copy;&nbsp;1998&ndash;2022. Паратайп. Все&nbsp;авторские&nbsp;права защищены.</span>
        <a class="footer__link" href="https://wemakefab.ru/" target="_blank" rel="noopener noreferrer">Дизайн Wemakefab</a>
      </div>
      <ul class="footer__socials socials">
        <li class="socials__item">
          <a class="socials__link" href="https://t.me/paratype_fonts" target="_blank" rel="noopener noreferrer">
            <span class="visually-hidden">Мы в Телеграме</span>
            <svg width="18" height="15" viewBox="0 0 18 15">
              <use href="{{sprite "telegram"}}"></use>
            </svg>
          </a>
        </li>
        <li class="socials__item">
          <a class="socials__link" href="https://vk.com/paratypefoundry" target="_blank" rel="noopener noreferrer">
            <span class="visually-hidden">Мы во ВКонтакте</span>
            <svg width="22" height="12" viewBox="0 0 22 12">
              <use href="{{sprite "vk"}}"></use>
            </svg>
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>
